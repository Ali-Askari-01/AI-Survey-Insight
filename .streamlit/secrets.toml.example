# Copy this file to .streamlit/secrets.toml for local testing,
# and set the same keys in Streamlit Cloud > App settings > Secrets.

GEMINI_API_KEY = "your-gemini-key"
ASSEMBLYAI_API_KEY = "your-assemblyai-key"
JWT_SECRET = "optional-strong-secret"
DATA_DIR = "./data"

# Optional OAuth keys if you expose auth-related flows later.
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
GOOGLE_REDIRECT_URI = ""
