{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "frontend_legacy",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/app", "destination": "/index" },
    { "source": "/survey-form", "destination": "/survey-form" },
    { "source": "/survey-chat", "destination": "/survey-chat" },
    { "source": "/survey-audio", "destination": "/survey-audio" },
    { "source": "/analytics-dashboard", "destination": "/analytics-dashboard" },
    { "source": "/interview/:shareCode/:channel", "destination": "/interview" },
    { "source": "/interview/:shareCode", "destination": "/interview" },
    { "source": "/", "destination": "/landing" },
    { "source": "/:path*", "destination": "/landing" }
  ]
}
