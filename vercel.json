{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/css/:path*", "destination": "/frontend_legacy/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend_legacy/js/:path*" },
    { "source": "/assets/:path*", "destination": "/frontend_legacy/assets/:path*" },
    { "source": "/app", "destination": "/frontend_legacy/index.html" },
    { "source": "/survey-form", "destination": "/frontend_legacy/survey-form.html" },
    { "source": "/survey-chat", "destination": "/frontend_legacy/survey-chat.html" },
    { "source": "/survey-audio", "destination": "/frontend_legacy/survey-audio.html" },
    { "source": "/analytics-dashboard", "destination": "/frontend_legacy/analytics-dashboard.html" },
    { "source": "/interview/:shareCode/:channel", "destination": "/frontend_legacy/interview.html" },
    { "source": "/interview/:shareCode", "destination": "/frontend_legacy/interview.html" },
    { "source": "/", "destination": "/frontend_legacy/landing.html" },
    { "source": "/:path*", "destination": "/frontend_legacy/landing.html" }
  ]
}
