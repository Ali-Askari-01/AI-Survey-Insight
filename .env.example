# AI Survey Software — Environment Variables
# Copy this file to .env and fill in your actual values
# ⚠️  NEVER commit .env to version control

# ═══════════════════════════════════════════════════
# RAILWAY DEPLOYMENT
# Railway auto-sets PORT — do not set it manually
# ═══════════════════════════════════════════════════
# PORT=8000  (set automatically by Railway)
# RAILWAY_ENVIRONMENT=production

# Data directory (set to Railway volume mount path if using volumes)
# DATA_DIR=/data
# LOG_DIR=/data/logs

# Google Gemini API Key (required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# AssemblyAI API Key (required for voice transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# JWT Secret for authentication (auto-generated if not set — SET THIS on Railway for multi-worker consistency)
JWT_SECRET=your_secret_key_here

# Google OAuth 2.0 (update redirect URI to your Railway domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/api/auth/google/callback

# Rate Limiting
RATE_LIMIT_RPM=120
RATE_LIMIT_AI_RPM=30

# Workers (Railway Hobby plan = 8 vCPU shared, set conservatively)
WORKERS=2

# Logging
LOG_LEVEL=INFO

# Email Notifications (optional — leave blank to use mailto: fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Survey Platform
SMTP_USE_TLS=true
